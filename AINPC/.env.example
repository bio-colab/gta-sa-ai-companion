# ====================================================================
# GTA San Andreas - AI NPC Companion Environment Configuration
# Get your free ultra-fast API key at https://console.groq.com/keys
# ====================================================================

# Your Groq Cloud API Key
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (Universally available on all Groq accounts: llama-3.3-70b-versatile or llama-3.1-8b-instant)
GROQ_MODEL=llama-3.3-70b-versatile

# Speech-To-Text Model for Voice Input (Hold T in game)
GROQ_STT_MODEL=whisper-large-v3-turbo
